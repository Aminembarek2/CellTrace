# Export these variables or use celltrace --env-file .env before the command.
# Explicit credential loading reads only OPENROUTER_API_KEY and keeps environment precedence.
# API access requires OpenRouter credit.
OPENROUTER_API_KEY=
CELLTRACE_MODEL=deepseek/deepseek-v4.1-flash
CELLTRACE_CONFIG=configs/project-defaults.yaml
CELLTRACE_DATA_DIR=data
